  <step>
    <name>Comprobar 13 grupos</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <send_true_to>Comprobar 15 reservas</send_true_to>
    <send_false_to>Abortar: grupos incorrectos</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <conditions>
          <condition>
            <negated>N</negated>
            <leftvalue>recuento_filas</leftvalue>
            <function>=</function>
            <rightvalue/>
            <value>
              <name>constant</name>
              <type>Number</type>
              <text>13.0</text>
              <length>-1</length>
              <precision>-1</precision>
              <isnull>N</isnull>
              <mask>####0.0#########;-####0.0#########</mask>
            </value>
          </condition>
          <condition>
            <negated>N</negated>
            <operator>AND NOT</operator>
            <leftvalue/>
            <function>=</function>
            <rightvalue/>
          </condition>
        </conditions>
      </condition>
    </compare>
